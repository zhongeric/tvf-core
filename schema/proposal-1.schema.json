{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhongeric/tvf-core/schema/proposal-1.schema.json",
  "title": "tvf-core change proposal, format 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal", "id", "base", "next", "checks", "summary", "rationale", "proposer", "source"],
  "properties": {
    "proposal": { "const": "1" },
    "id": { "type": "string", "pattern": "^[0-9]{4}-[a-z0-9][a-z0-9-]{0,47}$" },
    "base": { "$ref": "#/$defs/ref" },
    "next": { "$ref": "#/$defs/ref" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,47}$" }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 280 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "proposer": { "type": "string", "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9-]{0,38})|0x[0-9a-fA-F]{40})$" },
    "source": { "enum": ["external", "drafting-job"] }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "core" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
      }
    }
  }
}
